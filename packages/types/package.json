{
  "name": "@yogesh/types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript types across all apps",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./pipeline": {
      "import": "./dist/pipeline.js",
      "types": "./dist/pipeline.d.ts"
    },
    "./youtube": {
      "import": "./dist/youtube.js",
      "types": "./dist/youtube.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
